# Track the private symlink, never its contents if replaced by a directory.
/private/**
/venv/
/.runtime/
**/__pycache__/
*.py[cod]
.DS_Store

# Local archive in the root data directory; data/README.md and manifests stay tracked.
/data/raw/
/data/derived/
/data/runs/
# Local access symlinks into private/data.
/data/raw
/data/derived
/data/runs

# Legacy locations until their contents are classified and moved.
/output/
/output_applestore/
/checkpoints/
/checkpoints_applestore/
/poc_reviews_*.csv

# Raw review bases stay local even if placed elsewhere.
*.parquet

# Rendered local descriptive report.
/analysis/*.html
/analysis/*_files/
/analysis/*_files
/analysis/output
/analysis/output/
/analysis/app-store-output
/analysis/app-store-output/
# Legacy report access links, removed by archive_setup.
/analysis/google-play-descritiva-output
